{
  "name": "@academy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": "./dist/main.js"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest run",
    "test:curriculum-db": "ACADEMY_CURRICULUM_DB_TEST=1 vitest run test/curriculum-db.test.ts",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "import-content": "node --experimental-strip-types scripts/import-cli.ts"
  },
  "dependencies": {
    "@academy/schema": "workspace:*",
    "@effect/platform-node": "catalog:effect4",
    "@effect/sql-pg": "catalog:effect4",
    "drizzle-orm": "0.45.3",
    "effect": "catalog:effect4",
    "ioredis": "5.7.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
