{
  "name": "@academy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": "./dist/main.js"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest run",
    "test:curriculum-db": "ACADEMY_CURRICULUM_DB_TEST=1 vitest run test/curriculum-db.test.ts",
    "test:search-db": "ACADEMY_SEARCH_DB_TEST=1 vitest run test/search-db.test.ts",
    "test:notion-db": "ACADEMY_CURRICULUM_DB_TEST=1 vitest run test/notion-import-db.test.ts",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "import-content": "node --experimental-strip-types scripts/import-cli.ts",
    "import": "node --experimental-strip-types scripts/import.ts"
  },
  "dependencies": {
    "@academy/actions": "workspace:^",
    "@academy/schema": "workspace:*",
    "@effect/platform-node": "catalog:effect4",
    "@effect/sql-pg": "catalog:effect4",
    "drizzle-orm": "0.45.3",
    "effect": "catalog:effect4",
    "ioredis": "5.7.0",
    "pg": "8.16.3",
    "ws": "^8.21.3",
    "@academy/i18n": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.11"
  }
}
