{
  "name": "aetherlink-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm run build:legacy && pnpm run build:workspace",
    "build:legacy": "vite build",
    "build:workspace": "pnpm --recursive --filter './apps/**' --filter './packages/**' run build",
    "typecheck": "pnpm --recursive --filter './apps/**' --filter './packages/**' run typecheck",
    "test": "pnpm --recursive --filter './apps/**' --filter './packages/**' run test",
    "test:e2e": "pnpm --filter @academy/web run test:e2e",
    "test:visual:legacy": "playwright test -c tests/visual/playwright.config.mjs",
    "test:services": "ACADEMY_WAVE_DOCKER_TEST=1 pnpm --filter @academy/server run test",
    "test:legacy": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "dev": "pnpm --recursive --parallel --filter './apps/**' run dev",
    "start": "node scripts/start.mjs",
    "start:legacy": "node scripts/start.mjs",
    "tsc6": "tsc6",
    "mcp": "node server/mcp.mjs",
    "lint": "oxlint -c .oxlintrc.json -D no-undef src",
    "lint:content:support-1": "node content/scripts/lint-support-1.mjs",
    "lint:content:support-2": "node content/scripts/lint-support-2.mjs",
    "lint:content:support-3": "node content/scripts/lint-support-3.mjs",
    "lint:content:teaching-1": "node content/scripts/lint-teaching-1.mjs",
    "lint:content:teaching-2": "node content/scripts/lint-teaching-2.mjs",
    "lint:content:support-4": "node content/scripts/lint-support-4.mjs",
    "lint:content:support-5": "node content/scripts/lint-support-5.mjs",
    "lint:content:day-packs": "node content/scripts/lint-day-packs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "3.22.2",
    "express": "5.2.1",
    "ioredis": "5.7.0",
    "lucide-react": "0.468.0",
    "nanoid": "6.0.1",
    "nodemailer": "10.0.10",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "oxlint": "1.85.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.19.0"
}
