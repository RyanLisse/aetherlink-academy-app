      ],
      "id": "13ba4278-46c5-4566-97fe-dd5daf905afa",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "toolDescription": "Get Weather \u2014 fetch the deterministic training-lab weather fixture for a city and date. Same contract as day-2 Eve/Claude get_weather. Query: city, date. Base URL comes from Weather Input.weatherBaseUrl (default http://127.0.0.1:48135).",
        "method": "GET",
        "url": "={{ $('Weather Input').item.json.weatherBaseUrl }}/weather",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "city",
              "valueProvider": "fieldValue",
              "value": "={{ $('Weather Input').item.json.city }}"
            },
            {
              "name": "date",
              "valueProvider": "fieldValue",
              "value": "={{ $('Weather Input').item.json.date }}"
            }
          ]
        },
        "placeholderDefinitions": {
          "values": []
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        280,
        240
      ],
      "id": "dd224c43-9bd8-4e96-9eb8-cb5f5c86d26e",
      "name": "Get Weather"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output || $json;\nlet parsed;\nif (typeof raw === 'string') {\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  parsed = JSON.parse(start >= 0 ? raw.slice(start, end + 1) : raw);\n} else {\n  parsed = raw;\n}\nconst decision = String(parsed.decision || '').toLowerCase();\nreturn [{ json: { ...parsed, decision, draft_only: true, human_approval_required: true } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        0
      ],
      "id": "5d79d5fc-d262-446f-b8c7-444657485379",
