    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the Weather Agent for a fictional training lab (Fictional Reconciliation programme).\n\nInput:\n- city: {{ $json.city }}\n- date: {{ $json.date }}\n- weatherBaseUrl: {{ $json.weatherBaseUrl }}\n\nRules:\n1. Call the Get Weather tool exactly once with city and date.\n2. Keep the returned fixture fields in your answer.\n3. Decide bring umbrella when precipitationProbability >= 60, otherwise leave umbrella.\n4. Return ONLY JSON:\n{\n  \"city\": \"...\",\n  \"date\": \"...\",\n  \"temperatureC\": 0,\n  \"condition\": \"...\",\n  \"precipitationProbability\": 0,\n  \"decision\": \"bring umbrella | leave umbrella\",\n  \"draft_message\": \"short draft reminder for a human to review\",\n  \"draft_only\": true,\n  \"human_approval_required\": true\n}\n\nNever send a message. Never invent weather outside the tool result.",
        "options": {
          "systemMessage": "Use Get Weather. Draft only. Human approval required. No real sends."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        80,
        0
      ],
      "id": "1c06c950-4887-4895-95fc-72ab2e3d88b8",
      "name": "Weather Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
