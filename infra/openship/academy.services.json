{
  "services": [
    {
      "name": "app",
      "kind": "compose",
      "build": ".",
      "dockerfile": "Dockerfile",
      "environment": {
        "ACADEMY_STORAGE": "postgres",
        "HOST": "0.0.0.0",
        "PORT": "4317",
        "ACADEMY_DATA": "/data",
        "NODE_EXTRA_CA_CERTS": "/tls/ca.crt"
      },
      "ports": [
        "0.0.0.0:4317:4317"
      ],
      "volumes": [
        "data:/data",
        "/root/aetherlink-academy-openship/tls:/tls:ro"
      ],
      "dependsOn": [
        "postgres",
        "redis"
      ],
      "restart": "unless-stopped",
      "exposed": false
    },
    {
      "name": "postgres",
      "kind": "compose",
      "image": "postgres:16",
      "environment": {
        "POSTGRES_USER": "academy",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_DB": "academy"
      },
      "commandArgv": [
        "postgres",
        "-c",
        "ssl=on",
        "-c",
        "ssl_cert_file=/tls/postgres.crt",
        "-c",
        "ssl_key_file=/tls/postgres.key",
        "-c",
        "hba_file=/tls/pg_hba.conf"
      ],
      "volumes": [
        "pgdata:/var/lib/postgresql/data",
        "/root/aetherlink-academy-openship/tls:/tls:ro"
      ],
      "restart": "unless-stopped",
      "exposed": false
    },
    {
      "name": "redis",
      "kind": "compose",
      "image": "redis:7-alpine",
      "commandArgv": [
        "sh",
        "-c",
        "exec redis-server --save \"\" --appendonly no --port 0 --tls-port 6379 --tls-cert-file /tls/redis.crt --tls-key-file /tls/redis.key --tls-ca-cert-file /tls/ca.crt --tls-auth-clients no --requirepass \"$REDIS_PASSWORD\""
      ],
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD}",
        "REDISCLI_AUTH": "${REDIS_PASSWORD}"
      },
      "volumes": [
        "/root/aetherlink-academy-openship/tls:/tls:ro"
      ],
      "restart": "unless-stopped",
      "exposed": false
    }
  ]
}
