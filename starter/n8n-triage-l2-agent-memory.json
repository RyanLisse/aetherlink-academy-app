      "typeVersion": 1.3,
      "position": [
        80,
        192
      ],
      "id": "0f94ac26-cc52-5b5c-a332-4cb082875e11",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "AetherLink workshop OpenAI (placeholder)"
        }
      }
