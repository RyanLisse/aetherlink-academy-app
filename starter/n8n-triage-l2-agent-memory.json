        "jsCode": "const raw = $json.output || $json;\n\nlet parsed;\n\nif (typeof raw === 'string') {\n  parsed = JSON.parse(raw);\n} else {\n  parsed = raw;\n}\n\nreturn { json: parsed };"
      },
      "type": "n8n-nodes-base.code",
